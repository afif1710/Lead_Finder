{
  "name": "maps-lead-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Local-only Google Maps CSV exporter for Chrome and Edge.",
  "scripts": {
    "vendor": "node scripts/vendor.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "check": "node scripts/check.cjs",
    "package": "powershell -NoProfile -File scripts/package.ps1",
    "automation": "node automation/cli.mjs",
    "test:automation": "node --test automation/tests/*.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "libphonenumber-js": "^1.13.14",
    "playwright": "^1.63.0"
  }
}
